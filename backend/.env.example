# === Neon Postgres ===
# Ambil dari dashboard neon.com (Connection string). Region terdekat: Singapore.
DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# === Kunci untuk Android listener ===
# String acak panjang. HP (Android) WAJIB mengirim header: X-API-Key: <nilai ini>
# saat POST ke /api/notif. Jangan pernah commit nilai aslinya.
# Contoh generate: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
LISTENER_API_KEY="ganti-dengan-string-acak-panjang"

# === (Opsional) Kunci untuk cron pembersih expiry ===
# Dipakai Vercel Cron. Boleh dikosongkan saat development.
CRON_SECRET="ganti-dengan-string-acak"

# === Webhook ke web utama (toko online / kasir Anda) ===
# Dipakai menandatangani payload webhook (header X-Signature = HMAC-SHA256).
# Web utama memakai nilai yang sama untuk memverifikasi keaslian notifikasi "PAID".
WEBHOOK_SECRET="ganti-dengan-string-acak"

# === QRIS statis merchant ===
# String RAW hasil decode QR statis kamu (diawali "00020101021126..." dan diakhiri 4 char CRC).
# Backend otomatis mengubahnya jadi QRIS dinamis + nominal unik per order.
# Cara ambil: decode gambar QRIS statismu (mis. via app QRISin) lalu salin teks mentahnya.
QRIS_STATIC=""
